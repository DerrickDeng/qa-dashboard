# QA dashboard configuration.
# `make setup` and `make up` copy this to .env and generate the two secrets below.
# .env is gitignored. Never commit real secrets.

# --- Security -------------------------------------------------------------------
# Signs browser sessions. Generated on first run. Changing it signs everyone out.
QA_SESSION_SECRET=
# The bearer token push scripts and CI must send to /api/v1/ingest/*. Generated on first run.
QA_INGEST_TOKEN=
# How long a sign-in lasts.
QA_SESSION_MAX_AGE_HOURS=12
# Set to true once the dashboard is served over HTTPS.
QA_SESSION_COOKIE_SECURE=false

# --- Browser access ---------------------------------------------------------------
QA_CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

# --- Storage (optional; the defaults live in the repository root) --------------
# QA_DATABASE_URL=sqlite+pysqlite:////absolute/path/qa_dashboard.db
# QA_STORAGE_ROOT=/absolute/path/storage

# --- JIRA (optional; export these for scripts/sync_jira.py) ---------------------
# The token is used only to call JIRA. It is never stored or returned.
# QA_JIRA_BASE_URL=https://jira.your-company.com
# QA_JIRA_EMAIL=
# QA_JIRA_API_TOKEN=
# QA_JIRA_API_VERSION=2
# QA_JIRA_JQL=issuetype in (Bug, Defect) AND created >= -90d ORDER BY created DESC
